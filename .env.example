# Copia este archivo como .env (NO se sube al repositorio) y llena los valores.
# En IntelliJ: Run Configuration > Environment variables. En Render/Railway: panel de variables.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5434/prueba
DB_USUARIO=postgres
DB_CLAVE=

# Llave AES-256 en Base64 (generar con: openssl rand -base64 32)
APP_AES_KEY=

# Contraseña del distribuidor en GestoPago (con ella se obtiene el token Bearer)
GESTOPAGO_PASSWORD=

# SOLO para pruebas locales: devuelve el código 2FA en la respuesta
PAGOS_2FA_DEVOLVER_CODIGO=false

# Correo (contraseña de aplicación de Gmail)
MAIL_USUARIO=
MAIL_CLAVE=
NOTIFICACIONES_ACTIVO=false
